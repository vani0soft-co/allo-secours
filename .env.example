# Allo Secours Environment Configuration

# API Configuration
API_BASE_URL=https://api.allo-secours.com
API_TIMEOUT=30

# Firebase (optionnel)
FIREBASE_PROJECT_ID=allo-secours-project
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY

# Google Maps API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# App Configuration
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
DEBUG_MODE=true

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=false
